 {
  "id": "live",
  "name": "直播",
  "draft": true,
  "steps": [
   {
    "title": "打開直播筆電",
    "dev": "acer"
   },
   {
    "title": "混音器接到 UR22C 錄音介面",
    "dev": "s70",
    "wires": [
     {
      "from": "soundcraft",
      "to": "s70",
      "cable": [
       "XLR",
       "6.35mm"
      ],
      "maybe": true
     },
     {
      "from": "s70",
      "to": "acer",
      "cable": [
       "USB-C",
       "USB-A"
      ],
      "note": "UR22C 那頭是 USB-C，筆電那頭是 USB-A"
     }
    ],
    "detail": [
     "接線前先把 UR22C 的 OUTPUT 旋鈕轉到最小",
     "背面 POWER SOURCE 開關切到 USB 3.0",
     "正面 USB 燈亮起就是接好了"
    ],
    "figs": [
     {
      "fig": "ur22c-front",
      "hi": [
       "in1",
       "in2",
       "out"
      ],
      "cap": "UR22C 正面"
     },
     {
      "fig": "ur22c-rear",
      "hi": [
       "src",
       "usb"
      ],
      "cap": "UR22C 背面"
     }
    ]
   },
   {
    "title": "活動攝影機接到 AverMedia 擷取卡",
    "dev": "avermedia",
    "wires": [
     {
      "from": "cam_event",
      "to": "avermedia",
      "cable": "HDMI"
     },
     {
      "from": "avermedia",
      "to": "acer",
      "cable": [
       "USB-A",
       "USB-C"
      ],
      "maybe": true
     }
    ]
   },
   {
    "title": "直播輸出接到 ATEN 擷取卡",
    "dev": "aten_cap",
    "wires": [
     {
      "from": "live_out",
      "to": "aten_cap",
      "cable": "HDMI"
     },
     {
      "from": "aten_cap",
      "to": "acer",
      "cable": [
       "USB-A",
       "USB-C"
      ],
      "maybe": true
     }
    ]
   },
   {
    "title": "網路線接到直播筆電",
    "dev": "acer",
    "wires": [
     {
      "from": "lan",
      "to": "acer",
      "cable": "RJ45"
     }
    ]
   },
   {
    "title": "打開直播軟體",
    "dev": "acer",
    "check": {
     "q": "直播的畫面和聲音都出來了嗎？",
     "sym": "sound:6"
    }
   }
  ],
  "end": [
   "結束直播，關閉直播軟體",
   "關掉直播筆電"
  ]
 },
