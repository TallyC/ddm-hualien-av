      "from": "cam_event",
      "to": "avermedia",
      "cable": "HDMI"
     },
     {
      "from": "avermedia",
      "to": "acer",
      "cable": [
       "USB-A",
       "USB-C"
      ],
      "maybe": true
     }
    ]
   },
   {
    "title": "直播輸出接到 ATEN 擷取卡",
    "dev": "aten_cap",
    "wires": [
     {
      "from": "live_out",
      "to": "aten_cap",
      "cable": "HDMI"
     },
     {
      "from": "aten_cap",
      "to": "acer",
      "cable": [
       "USB-A",
       "USB-C"
      ],
      "maybe": true
     }
    ]
   },
   {
    "title": "網路線接到直播筆電",
    "dev": "acer",
    "wires": [
     {
      "from": "lan",
      "to": "acer",
      "cable": "RJ45"
     }
    ]
   },
   {
    "title": "打開直播軟體",
    "dev": "acer",
    "check": {
     "q": "直播的畫面和聲音都出來了嗎？",
     "sym": "sound:6"
    }
   }
  ],
  "end": [
   "結束直播，關閉直播軟體",
   "關掉直播筆電"
